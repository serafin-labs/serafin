{
    "name": "serafin",
    "private": true,
    "description": "TypeScript libraries to build self-descriptive APIs: schemas, pipelines, OpenAPI documents and REST endpoints",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "coverage": "pnpm -r coverage",
        "check:exports": "pnpm -r check:exports",
        "check": "pnpm build && pnpm typecheck && pnpm test && pnpm coverage && pnpm check:exports && pnpm format:check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs:dev": "pnpm build && vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "changeset": "changeset",
        "version": "changeset version && pnpm install --lockfile-only",
        "release": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@shikijs/vitepress-twoslash": "^4.5.0",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.3",
        "@types/verror": "catalog:",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "concurrently": "^10.0.3",
        "mocha": "^12.0.3",
        "prettier": "^3.9.10",
        "tsx": "^4.22.4",
        "twoslash": "^0.3.9",
        "typescript": "^6.0.3",
        "verror": "catalog:",
        "vitepress": "^1.6.4"
    }
}
