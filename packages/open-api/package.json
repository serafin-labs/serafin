{
    "name": "@serafin/open-api",
    "version": "3.2.0",
    "description": "OpenAPI 3.2 type definitions and an immutable document builder",
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/cjs/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/esm/index.d.ts",
                "default": "./lib/esm/index.js"
            },
            "require": {
                "types": "./lib/cjs/index.d.ts",
                "default": "./lib/cjs/index.js"
            }
        }
    },
    "files": [
        "lib",
        "src",
        "!**/*.tsbuildinfo",
        "!src/test"
    ],
    "contributors": [
        {
            "name": "Sébastien de Saint Florent",
            "email": "sebastien.dsf@gmail.com"
        },
        {
            "name": "Nicolas Degardin",
            "email": "degardin.n@gmail.com"
        }
    ],
    "keywords": [
        "openapi",
        "swagger",
        "typescript",
        "builder"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/serafin-labs/open-api.git"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.3",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "concurrently": "^10.0.3",
        "mocha": "^12.0.3",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "test": "NODE_OPTIONS='--import tsx --no-warnings' mocha --recursive ./src/test/**/*.spec.ts",
        "predev": "npm install",
        "dev": "concurrently -c auto -n '' npm:dev:cjs npm:dev:esm npm:dev:test",
        "dev:cjs": "tsc --watch --preserveWatchOutput --project tsconfig.cjs.json",
        "dev:esm": "tsc --watch --preserveWatchOutput",
        "dev:test": "NODE_OPTIONS='--import tsx --no-warnings' mocha --reporter dot --watch --watch-files src --extension ts ./src/test/**/*.spec.ts",
        "build": "npm run build:esm && npm run build:cjs && npm run fix",
        "build:cjs": "tsc --project tsconfig.cjs.json",
        "build:esm": "tsc",
        "fix": "echo '{ \"type\": \"module\" }' > lib/esm/package.json && echo '{ \"type\": \"commonjs\" }' > lib/cjs/package.json",
        "check:exports": "node scripts/check-build-exports.mjs",
        "typecheck": "tsc --project tsconfig.typecheck.json",
        "coverage": "rm -rf .coverage-build && tsc --project tsconfig.coverage.json && echo '{ \"type\": \"module\" }' > .coverage-build/package.json && c8 mocha --recursive '.coverage-build/test/**/*.spec.js'",
        "prepublishOnly": "npm install && rm -rf ./lib && npm run build && npm run typecheck && npm test && npm run coverage && npm run check:exports"
    }
}
