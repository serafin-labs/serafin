{
    "name": "@serafin/api",
    "version": "0.15.1",
    "description": "A RESTful self-descriptive API based on Serafin pipelines",
    "keywords": [
        "api",
        "typescript",
        "rest",
        "self-descriptive",
        "openapi",
        "pipeline"
    ],
    "license": "MIT",
    "contributors": [
        {
            "name": "Sébastien de Saint Florent",
            "email": "sebastien.dsf@gmail.com"
        },
        {
            "name": "Nicolas Degardin",
            "email": "degardin.n@gmail.com"
        }
    ],
    "homepage": "https://serafin-labs.github.io/serafin/api/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/serafin-labs/serafin.git",
        "directory": "packages/api"
    },
    "bugs": {
        "url": "https://github.com/serafin-labs/serafin/issues"
    },
    "type": "module",
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/esm/index.d.ts",
                "default": "./lib/esm/index.js"
            },
            "require": {
                "types": "./lib/cjs/index.d.ts",
                "default": "./lib/cjs/index.js"
            }
        }
    },
    "files": [
        "lib",
        "src",
        "!**/*.tsbuildinfo",
        "!src/test"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rm -rf lib && pnpm build:esm && pnpm build:cjs && pnpm fix",
        "build:esm": "tsc",
        "build:cjs": "tsc --project tsconfig.cjs.json",
        "fix": "echo '{ \"type\": \"module\" }' > lib/esm/package.json && echo '{ \"type\": \"commonjs\" }' > lib/cjs/package.json",
        "dev": "concurrently -c auto -n '' pnpm:dev:cjs pnpm:dev:esm pnpm:dev:test",
        "dev:cjs": "tsc --watch --preserveWatchOutput --project tsconfig.cjs.json",
        "dev:esm": "tsc --watch --preserveWatchOutput",
        "dev:test": "NODE_OPTIONS='--import tsx --no-warnings' mocha --reporter dot --watch --watch-files src --extension ts './src/test/**/*.spec.ts'",
        "test": "NODE_OPTIONS='--import tsx --no-warnings' mocha --recursive './src/test/**/*.spec.ts'",
        "typecheck": "tsc --project tsconfig.typecheck.json",
        "coverage": "rm -rf .coverage-build && tsc --project tsconfig.coverage.json && echo '{ \"type\": \"module\" }' > .coverage-build/package.json && c8 mocha --recursive '.coverage-build/test/**/*.spec.js'",
        "check:exports": "node scripts/check-build-exports.mjs",
        "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test && pnpm coverage && pnpm check:exports"
    },
    "dependencies": {
        "qs": "^6.14.0",
        "verror": "catalog:"
    },
    "peerDependencies": {
        "@serafin/open-api": "workspace:^",
        "@serafin/pipeline": "workspace:^",
        "@serafin/schema-builder": "workspace:^",
        "express": "^4.21.0 || ^5.0.0"
    },
    "devDependencies": {
        "@serafin/open-api": "workspace:^",
        "@serafin/pipeline": "workspace:^",
        "@serafin/schema-builder": "workspace:^",
        "@types/express": "^5.0.6",
        "@types/express4": "npm:@types/express@^4.17.23",
        "@types/qs": "^6.14.0",
        "@types/verror": "catalog:",
        "chai-http": "^5.1.2",
        "express": "^5.1.0",
        "express4": "npm:express@^4.21.2"
    }
}
